#!/bin/sh
set -eu

cluster_name=${1:?Usage: localemu-kubeconfig <eks-cluster-name>}
k3d_cluster_name="localemu-eks-${cluster_name}"
config_path="${KUBECONFIG:-$HOME/.kube/config}"
host_name="${LOCALEMU_KUBE_HOST:-host.docker.internal}"
temp_path="${config_path}.tmp"

mkdir -p "$(dirname "$config_path")"
k3d kubeconfig get "$k3d_cluster_name" \
  | sed -E "s#(server: https://)(127\.0\.0\.1|localhost|0\.0\.0\.0):#\1${host_name}:#" > "$temp_path"
mv "$temp_path" "$config_path"
cluster_config_name=$(kubectl --kubeconfig "$config_path" config view --minify -o "jsonpath={.clusters[0].name}")
kubectl --kubeconfig "$config_path" config set-cluster "$cluster_config_name" --tls-server-name=localhost >/dev/null

printf 'Kubeconfig for %s written to %s (API host: %s)\n' "$cluster_name" "$config_path" "$host_name"
